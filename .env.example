# Telegram Credentials (get from https://my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_telegram_api_hash_here
TELEGRAM_PHONE=+1234567890
TELEGRAM_SESSION_NAME=librarian_session

# Storage Paths
DATABASE_PATH=processed_links.db
OBSIDIAN_VAULT_PATH=./vault
COOKIES_PATH=cookies.json

# AI Engine Configuration
# Set USE_OPENAI=true to use OpenAI GPT-4o, or false to use local Ollama
USE_OPENAI=false
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Ollama Local Settings (used when USE_OPENAI=false)
# If running inside Docker container accessing host machine Ollama, use http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# Self-Hosted Vision Model Settings (PixelRAG Visual Mode)
# Providers: 'ollama', 'vllm', 'openai'
VISION_ENABLED=true
VISION_PROVIDER=ollama
VISION_MODEL=llama3.2-vision
VISION_BASE_URL=http://localhost:11434
TILE_HEIGHT=1568

# Scraping Settings
PLAYWRIGHT_HEADLESS=true
SCRAPE_TIMEOUT_MS=30000

# Google Calendar Integration (Optional for Job scheduling)
GOOGLE_CALENDAR_CREDENTIALS=credentials.json
GOOGLE_CALENDAR_TOKEN=token.json
