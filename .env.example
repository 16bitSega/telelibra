# ==============================================================================
# Telelibra — Personal Intelligence ETL Pipeline (.env Configuration)
# ==============================================================================

# --- Telegram Credentials (get from https://my.telegram.org) ---
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_telegram_api_hash_here
TELEGRAM_PHONE=+380XXXXXXXXX
TELEGRAM_SESSION_NAME=librarian_telegram

# --- Storage & Paths ---
DATABASE_PATH=processed_links.db
OBSIDIAN_VAULT_PATH=./vault
COOKIES_PATH=cookies.json

# --- Primary LLM Provider Configuration ---
# Providers: 'llamacpp' (recommended for local Apple Silicon / Metal), 'openai', 'ollama'
LLM_PROVIDER=llamacpp

# --- llama.cpp / Local Server Settings ---
LLAMACPP_BASE_URL=http://localhost:8080/v1
LLAMACPP_MODEL_NAME=Muse-Glimmer-30B
REASONING_EFFORT=high

# --- Cloud OpenAI Settings (Fallback / Alternative) ---
USE_OPENAI=false
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# --- Local Ollama Settings (Fallback / Alternative) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# --- Vision & Multimodal Extraction (PixelRAG) ---
VISION_ENABLED=true
VISION_PROVIDER=llamacpp
VISION_MODEL=Muse-Glimmer-30B
VISION_BASE_URL=http://localhost:8080/v1
TILE_HEIGHT=1568

# --- Scraper & Playwright Settings ---
PLAYWRIGHT_HEADLESS=true
SCRAPE_TIMEOUT_MS=30000

# --- Google Calendar Integration (Optional for Jobs) ---
GOOGLE_CALENDAR_CREDENTIALS=credentials.json
GOOGLE_CALENDAR_TOKEN=token.json
