# Telegram Credentials (get from https://my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_telegram_api_hash_here
TELEGRAM_PHONE=+1234567890
TELEGRAM_SESSION_NAME=librarian_session

# Storage Paths
DATABASE_PATH=processed_links.db
OBSIDIAN_VAULT_PATH=./vault
COOKIES_PATH=cookies.json

# Primary Local AI Model: Muse-Glimmer-30B (llama.cpp on Apple Silicon Metal)
LLM_PROVIDER=llamacpp
LLAMACPP_BASE_URL=http://localhost:8080/v1
LLAMACPP_MODEL_NAME=Muse-Glimmer-30B
LLAMACPP_MODEL_PATH=llama/runtime/models/Muse-Glimmer-30B/muse-glimmer-30B-kquant-17gb.gguf
LLAMACPP_MMPROJ_PATH=llama/runtime/models/Muse-Glimmer-30B/mmproj-kquant.gguf
LLAMACPP_DRAFT_PATH=llama/runtime/models/Muse-Glimmer-30B/dflash-kquant.gguf
LLAMACPP_CONTEXT_SIZE=32768
LLAMACPP_SLOTS=1
REASONING_EFFORT=high

# Multimodal Vision Settings (PixelRAG Visual Engine)
VISION_ENABLED=true
VISION_PROVIDER=llamacpp
VISION_MODEL=Muse-Glimmer-30B
VISION_BASE_URL=http://localhost:8080/v1
TILE_HEIGHT=1568

# Alternative Local Model: Ollama (used if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# Cloud Model: OpenAI (used if USE_OPENAI=true or LLM_PROVIDER=openai)
USE_OPENAI=false
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Scraping Settings
PLAYWRIGHT_HEADLESS=true
SCRAPE_TIMEOUT_MS=30000

# Google Calendar Integration (Optional for Job scheduling)
GOOGLE_CALENDAR_CREDENTIALS=credentials.json
GOOGLE_CALENDAR_TOKEN=token.json
